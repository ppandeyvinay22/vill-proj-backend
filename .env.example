# ──────────────────────────────────────
# Village Food Platform — Environment
# ──────────────────────────────────────
# Copy this to .env and fill in real values

APP_NAME=Village Food API
ENV=development

# MongoDB
# For local dev:   mongodb://localhost:27017
# For Atlas cloud:  mongodb+srv://user:password@cluster.mongodb.net/?appName=Cluster0
MONGODB_URL=mongodb://localhost:27017
DATABASE_NAME=village_food

# Auth
SECRET_KEY=change_this_to_a_random_64_char_string_in_production

# Razorpay
RAZORPAY_KEY_ID=rzp_test_xxxxx
RAZORPAY_KEY_SECRET=xxxxx

# Shiprocket
SHIPROCKET_EMAIL=your@email.com
SHIPROCKET_PASSWORD=yourpassword
